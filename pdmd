#!/bin/bash
if [[ -z $1 ]]; then
	file=$(fzf --preview 'bat --style=numbers --color=always --line-range :500 {}')
	newFile=$(echo $file|sed "s/md/docx/I")
	pandoc -f markdown -t docx $file -o $newFile
else
	newFile=$(echo $1|sed "s/markdown/docx/I")
	pandoc -f markdown -t docx $1 -o $newFile
fi
libreoffice --view $newFile
